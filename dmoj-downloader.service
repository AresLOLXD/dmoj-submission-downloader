[Unit]
Description=DMOJ Submission Downloader
After=network.target

[Service]
Type=simple
User=dmoj-dl
WorkingDirectory=/opt/dmoj-downloader
EnvironmentFile=/opt/dmoj-downloader/.env
ExecStart=/opt/dmoj-downloader/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
